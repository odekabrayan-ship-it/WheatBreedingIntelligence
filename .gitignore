*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Node / Next.js
node_modules/
.next/
out/
dist/
.npm/
*.tsbuildinfo

